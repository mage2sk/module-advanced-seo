<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Form data provider virtual types: use GenericFormDataProvider so that
         form components receive data keyed by entity ID (avoids the
         searchResultToOutput / getCustomAttributes mismatch). -->
    <!-- RuleFormDataProvider is a real class now (decodes conditions/actions for edit form) -->
    <virtualType name="Panth\AdvancedSEO\Ui\Component\Form\DataProvider\CustomCanonicalFormDataProvider" type="Panth\AdvancedSEO\Ui\Component\Form\DataProvider\GenericFormDataProvider">
        <arguments>
            <argument name="collection" xsi:type="object">Panth\AdvancedSEO\Model\ResourceModel\CustomCanonical\Collection</argument>
            <argument name="dataPersistor" xsi:type="object">Magento\Framework\App\Request\DataPersistorInterface</argument>
            <argument name="persistorKey" xsi:type="string">panth_seo_custom_canonical</argument>
        </arguments>
    </virtualType>

    <!-- SERP Preview: inject live Google snippet preview into product/category edit forms -->
    <type name="Magento\Catalog\Ui\DataProvider\Product\Form\ProductDataProvider">
        <plugin name="panth_seo_product_serp_preview"
                type="Panth\AdvancedSEO\Plugin\Admin\SerpPreviewPlugin"
                sortOrder="10"/>
        <plugin name="panth_seo_product_seo_fields"
                type="Panth\AdvancedSEO\Plugin\Admin\ProductSeoFieldsPlugin"
                sortOrder="30"/>
    </type>
    <type name="Magento\Catalog\Model\Category\DataProvider">
        <plugin name="panth_seo_category_serp_preview"
                type="Panth\AdvancedSEO\Plugin\Admin\CategorySerpPreviewPlugin"
                sortOrder="10"/>
        <plugin name="panth_seo_category_score_widget"
                type="Panth\AdvancedSEO\Plugin\Admin\CategorySeoScorePlugin"
                sortOrder="25"/>
        <plugin name="panth_seo_category_seo_fields"
                type="Panth\AdvancedSEO\Plugin\Admin\CategorySeoFieldsPlugin"
                sortOrder="30"/>
        <plugin name="panth_seo_category_canonical_form"
                type="Panth\AdvancedSEO\Plugin\Canonical\CategoryFormPlugin"
                sortOrder="40"/>
    </type>

    <!-- Product save: persist custom canonical URL -->
    <type name="Magento\Catalog\Controller\Adminhtml\Product\Save">
        <plugin name="panth_seo_product_seo_fields_save"
                type="Panth\AdvancedSEO\Plugin\Admin\ProductSeoFieldsSavePlugin"
                sortOrder="30"/>
    </type>

    <!-- CMS page form: meta_robots + hreflang_identifier + custom canonical fields -->
    <type name="Magento\Cms\Model\Page\DataProvider">
        <plugin name="panth_seo_cms_page_seo_fields"
                type="Panth\AdvancedSEO\Plugin\Admin\CmsPageSeoFieldsPlugin"
                sortOrder="30"/>
        <plugin name="panth_seo_cms_canonical_form"
                type="Panth\AdvancedSEO\Plugin\Canonical\CmsPageFormPlugin"
                sortOrder="40"/>
    </type>

    <type name="Panth\AdvancedSEO\Block\Adminhtml\Audit">
        <arguments>
            <argument name="issuePersister" xsi:type="object">Panth\AdvancedSEO\Model\Audit\IssuePersister</argument>
            <argument name="issueCatalog" xsi:type="object">Panth\AdvancedSEO\Model\Audit\IssueCatalog</argument>
        </arguments>
    </type>
    <type name="Panth\Hreflang\Controller\Adminhtml\Hreflang\Save">
        <plugin name="panth_seo_hreflang_group_guard" type="Panth\AdvancedSEO\Plugin\Hreflang\GroupGuardPlugin" sortOrder="10"/>
    </type>

    <!-- CMS page save: persist meta_robots + hreflang_identifier -->
    <type name="Magento\Cms\Controller\Adminhtml\Page\Save">
        <plugin name="panth_seo_cms_page_seo_fields_save"
                type="Panth\AdvancedSEO\Plugin\Admin\CmsPageSeoFieldsSavePlugin"
                sortOrder="30"/>
    </type>

    <type name="Panth\AdvancedSEO\Controller\Adminhtml\CustomCanonical\Save">
        <arguments>
            <argument name="dataPersistor" xsi:type="object">Magento\Framework\App\Request\DataPersistorInterface</argument>
            <argument name="cacheInvalidator" xsi:type="object">Panth\AdvancedSEO\Model\Cache\SeoCacheInvalidator</argument>
        </arguments>
    </type>
    <type name="Panth\AdvancedSEO\Controller\Adminhtml\CustomCanonical\Delete">
        <arguments>
            <argument name="cacheInvalidator" xsi:type="object">Panth\AdvancedSEO\Model\Cache\SeoCacheInvalidator</argument>
        </arguments>
    </type>
    <type name="Panth\AdvancedSEO\Controller\Adminhtml\CustomCanonical\MassDelete">
        <arguments>
            <argument name="cacheInvalidator" xsi:type="object">Panth\AdvancedSEO\Model\Cache\SeoCacheInvalidator</argument>
        </arguments>
    </type>
    <type name="Panth\AdvancedSEO\Controller\Adminhtml\Feed\Save">
        <arguments>
            <argument name="dataPersistor" xsi:type="object">Magento\Framework\App\Request\DataPersistorInterface</argument>
        </arguments>
    </type>
    <type name="Panth\AdvancedSEO\Ui\Component\Form\DataProvider\FeedFormDataProvider">
        <arguments>
            <argument name="dataPersistor" xsi:type="object">Magento\Framework\App\Request\DataPersistorInterface</argument>
        </arguments>
    </type>
    <virtualType name="Panth\AdvancedSEO\Model\Config\Source\CanonicalTargetEntityType" type="Panth\AdvancedSEO\Model\Config\Source\CanonicalEntityType">
        <arguments>
            <argument name="withNone" xsi:type="boolean">true</argument>
        </arguments>
    </virtualType>
    <type name="Panth\AdvancedSEO\Controller\Adminhtml\BulkEditor\InlineEdit">
        <arguments>
            <argument name="productAction" xsi:type="object">Magento\Catalog\Model\Product\Action</argument>
            <argument name="cacheInvalidator" xsi:type="object">Panth\AdvancedSEO\Model\Cache\SeoCacheInvalidator</argument>
            <argument name="metaCache" xsi:type="object">Panth\AdvancedSEO\Model\Meta\Cache</argument>
            <argument name="resolvedRepository" xsi:type="object">Panth\AdvancedSEO\Model\Meta\ResolvedRepository</argument>
        </arguments>
    </type>
    <type name="Panth\AdvancedSEO\Controller\Adminhtml\BulkEditor\Save">
        <arguments>
            <argument name="productAction" xsi:type="object">Magento\Catalog\Model\Product\Action</argument>
            <argument name="cacheInvalidator" xsi:type="object">Panth\AdvancedSEO\Model\Cache\SeoCacheInvalidator</argument>
            <argument name="metaCache" xsi:type="object">Panth\AdvancedSEO\Model\Meta\Cache</argument>
            <argument name="resolvedRepository" xsi:type="object">Panth\AdvancedSEO\Model\Meta\ResolvedRepository</argument>
        </arguments>
    </type>
</config>
