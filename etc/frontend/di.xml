<?xml version="1.0"?>
<!--
  Frontend-only DI: these plugins ONLY load on storefront requests.
  They are NEVER instantiated on admin, API, or cron requests.
  This prevents session/form-key issues in the admin panel.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- HTTP header plugins: frontend-only -->
    <type name="Magento\Framework\App\Response\Http">
        <plugin name="panth_seo_canonical_header" type="Panth\AdvancedSEO\Plugin\Response\CanonicalHeaderPlugin" sortOrder="20"/>
        <plugin name="panth_seo_last_modified_header" type="Panth\AdvancedSEO\Plugin\Response\LastModifiedHeaderPlugin" sortOrder="30"/>
    </type>

    <!-- SEO Toolbar: frontend-only -->
    <type name="Magento\Framework\View\Result\Page">
        <plugin name="panth_seo_seo_toolbar" type="Panth\AdvancedSEO\Plugin\Frontend\SeoToolbarPlugin" sortOrder="10"/>
    </type>

    <type name="Panth\StructuredData\Api\StructuredDataProviderInterface">
        <plugin name="panth_seo_strip_invalid_schema_props" type="Panth\AdvancedSEO\Plugin\StructuredData\StripInvalidSchemaPropsPlugin" sortOrder="100"/>
    </type>
    <type name="Magento\Catalog\Helper\Output">
        <plugin name="panth_seo_readme_links" type="Panth\AdvancedSEO\Plugin\Content\ReadmeLinkPlugin" sortOrder="100"/>
    </type>
    <type name="Magento\Cms\Model\Template\Filter">
        <plugin name="panth_seo_readme_links" type="Panth\AdvancedSEO\Plugin\Content\ReadmeLinkPlugin" sortOrder="100"/>
    </type>
    <type name="Magento\Framework\View\Page\Config">
        <plugin name="panth_seo_title_guard" type="Panth\AdvancedSEO\Plugin\PageConfig\SeoTitleGuardPlugin" sortOrder="90"/>
    </type>
</config>
